# =====================================================================
# .env.example | متغیرهای محیطی «بک‌اند»
# این فایل فقط نمونه است. مقدار واقعی را در تنظیمات امن سرویس خودت
# (Supabase Secrets / متغیرهای محیطی سرور) وارد کن؛ هرگز در Repository قرار نده.
# فرانت‌اند (GitHub Pages) هیچ Secret ی ندارد؛ فقط js/config.js را ویرایش می‌کنی.
# =====================================================================

# ---- عمومی ----
APP_ENV=production                       # development | production  (در production هیچ OTP آزمایشی فعال نیست)
SITE_ORIGIN=https://behnamninja20-dev.github.io   # برای CORS و بررسی Origin
CORS_ALLOWED_ORIGINS=https://behnamninja20-dev.github.io
SESSION_COOKIE_DOMAIN=                    # در صورت نیاز
SESSION_SECRET=CHANGE_ME_long_random_string

# ---- پایگاه داده (Supabase / PostgreSQL) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY           # عمومی است ولی همچنان در config نگذار مگر لازم باشد
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # ⚠️ فقط سمت سرور
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- OTP (کد ۵ رقمی) ----
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR_PER_TARGET=5
OTP_MAX_SENDS_PER_HOUR_PER_IP=20
OTP_PEPPER=CHANGE_ME_random_secret        # برای HMAC کد؛ کد خام ذخیره نمی‌شود

# ---- پیامک (یکی را انتخاب کن) ----
SMS_PROVIDER=                              # مثلاً twilio | kavenegar | ghasedak ...
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE_ID=

# ---- ایمیل ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Behnam <no-reply@YOUR_DOMAIN>"

# ---- OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                         # محتوای فایل .p8

# ---- ضدسوءاستفاده (برای فرم مشاوره مهمان) ----
TURNSTILE_SECRET_KEY=                      # Cloudflare Turnstile یا reCAPTCHA

# ---- آپلود فایل ----
UPLOAD_MAX_MB=5
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
